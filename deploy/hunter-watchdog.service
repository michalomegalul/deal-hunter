[Unit]
Description=Deal Hunter: push an alert if a background job is stale or failing
After=docker.service
OnFailure=hunter-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/deal-hunter
# A hung watchdog run must not block forever and delay the next check.
TimeoutStartSec=5min
ExecStart=/usr/bin/docker compose run --rm -T hunter watchdog
