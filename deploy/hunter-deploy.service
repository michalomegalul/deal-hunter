[Unit]
Description=Deal Hunter: deploy the latest GitHub release if it is new
After=docker.service network-online.target
Wants=network-online.target
OnFailure=hunter-notify-failure@%n.service

[Service]
Type=oneshot
# A hung pull/migrate/restart must not block forever and stall every later tick behind it.
TimeoutStartSec=20min
ExecStart=/opt/deal-hunter/deploy.sh
