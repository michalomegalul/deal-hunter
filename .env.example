# Copy to .env and fill in. NEVER commit .env.
# Local dev database (dev-only credentials), e.g. from docker-compose.yml.
DATABASE_URL=postgresql://hunter:hunter@localhost:5432/hunter
# Optional tuning (defaults shown). HUNTER_MIN_DELAY can't go below 3 seconds.
# HUNTER_MIN_DELAY=3.5
# HUNTER_PAGES=2
# HUNTER_LOOP_MINUTES=10
# HUNTER_RECHECK_HOURS=6
# HUNTER_RECHECK_LIMIT=1500
# HUNTER_SECTIONS=graficka,pc,notebook,hdd,pamet,sit,wifi,case,motherboard

# --- more sources, same pipeline (defaults shown) ---
# HUNTER_SOURCES=bazos                 # bazos,sbazar,aukro,fb,mironet -- sbazar is permanently blocked by
#                                       # robots.txt (see sbazar.py); fb also needs FB_COOKIES_FILE;
#                                       # mironet = the shop's unboxed/bazar outlet items (see shops.py)
# HUNTER_AUKRO_PAGES=1                 # category pages per cycle, per Aukro category (60 items/page)
# HUNTER_SHOP_PAGES=2                  # pages per shop outlet category (mironet), at most
# HUNTER_SHOP_HOURS=6                  # hours between passes over the shop outlets
# HUNTER_SHOP_MIN_DELAY=6.5            # seconds between requests to a shop (never below 6)
# FB_COOKIES_FILE=                     # path to a Cookie-Editor JSON export; empty = fb disabled.
#                                       # Root-only file on the server. NEVER commit it.
# HUNTER_FB_QUERIES=                   # 'rtx 3060:graficka,thinkpad t480:notebook,rx 6700:graficka'
# HUNTER_FB_CITY=prague
# HUNTER_FB_RADIUS_KM=40
# HUNTER_FB_MIN_GAP=8                  # seconds between queries within one fb cycle
# HUNTER_FB_MAX_GAP=15
# HUNTER_FB_CYCLE_MIN_MINUTES=20       # the fb cycle itself runs every 20-30 min (jittered)
# HUNTER_FB_CYCLE_MAX_MINUTES=30

# --- worker: fair prices, LLM triage, alerts (defaults shown) ---
# HUNTER_WORK_MINUTES=5
# HUNTER_OLLAMA_URL=http://192.168.4.19:11434
# HUNTER_LLM_MODEL=gemma3:12b          # empty = no triage
# HUNTER_LLM_CACHE=data/llm_cache
# HUNTER_TRIAGE_PER_CYCLE=6
# HUNTER_CANDIDATE_DISCOUNT=0.2        # candidates: at least 20 % below fair
# ntfy: publish/poll on the LAN, 👍/👎 buttons call the public URL (the phone may be anywhere)
# HUNTER_NTFY_URL=http://192.168.4.36
# HUNTER_NTFY_PUBLIC_URL=https://ntfy.dobsinsky.dev
# HUNTER_NTFY_TOPIC=deals
# HUNTER_NTFY_FEEDBACK_TOPIC=deals-feedback
# NTFY_TOKEN=tk_...                    # user deal-hunter: write deals, read deals-feedback
# NTFY_FEEDBACK_TOKEN=tk_...           # user deals-feedback-writer: write-only deals-feedback
# HUNTER_ALERTS_ENABLED=false          # the global switch; the per-model gate comes on top
# HUNTER_ALERT_MIN_SCORE=0.12
# HUNTER_ALERT_MAX_PER_DAY=5
# HUNTER_ALERT_MIN_SAMPLES=15          # gate: priced samples of the model
# HUNTER_ALERT_MIN_DAYS=7              # gate: days of data in the model's category
# HUNTER_QUIET_HOURS=23-7              # Europe/Prague
# HUNTER_QUIET_BYPASS_SCORE=0.3

# --- auctions (nms.gov.cz), inside the worker (defaults shown) ---
# HUNTER_AUCTIONS=true                  # the whole auction step
# HUNTER_AUCTION_MIN_DELAY=6            # seconds between requests to nms.gov.cz (never below 5)
# HUNTER_AUCTION_LIST_HOURS=2.5         # how often the lot lists are read
# HUNTER_AUCTION_DETAILS_PER_CYCLE=12
# HUNTER_AUCTION_EXTRACT_PER_CYCLE=3    # LLM reads per worker cycle
# HUNTER_AUCTION_MAX_PER_DAY=3          # auction pushes a day, on top of HUNTER_ALERT_MAX_PER_DAY
# HUNTER_AUCTION_HOURLY_RATE=200        # Kč per hour of your time
# HUNTER_AUCTION_MINUTES_PER_UNIT=40    # refurb + selling effort per unit
# HUNTER_AUCTION_RESALE_FACTOR=0.9      # sale price vs the Bazoš asking-price median
# HUNTER_AUCTION_SELL_PER_WEEK=5        # units of one lot Bazoš absorbs in a week
# HUNTER_AUCTION_LOT_COST=500           # transport per lot (Kč)
# HUNTER_AUCTION_LOT_HOURS=2            # pickup time per lot
# HUNTER_AUCTION_TARGET_MARGIN=0.3      # max bid leaves this share of revenue as profit
# HUNTER_AUCTION_MIN_PROFIT=1500        # minimum profit at the next bid to push

# --- new prices and 👍 follow-ups (defaults shown) ---
# HUNTER_USD_CZK=23.5                   # launch MSRPs (USD) to Kč, for display and the sanity check
# HUNTER_NEW_PRICES=true                # weekly Zboží.cz product pages (new_price_pages.yaml) and Datart.cz
#                                       # category pages, in the worker
# HUNTER_NEW_PRICE_DAYS=7
# HUNTER_NEW_PRICE_MIN_DELAY=6.5        # seconds between requests to Zboží.cz and Datart.cz (never below 6)
# HUNTER_NEW_PRICE_PER_CYCLE=10         # Zboží product pages per worker cycle
# HUNTER_DATART_PAGES=4                 # pages per Datart category (22 products each)
# HUNTER_OFFER_DISCOUNT=0.07            # the follow-up's proposed price, below asking (clamped 5-10 %)

# --- distance from home (defaults shown) ---
# HUNTER_HOME_PSC=                      # e.g. 140 00; overrides HUNTER_HOME_LAT/LON when it is a known PSČ
# HUNTER_HOME_LAT=50.0755               # Prague centre
# HUNTER_HOME_LON=14.4378
# HUNTER_PICKUP_KM=40                   # pickup radius (straight line); 0 = no distance rule
# HUNTER_PICKUP_KM_HDD=                 # per category: HDD, GPU, OFFICE_PC, OFFICE_LAPTOP (OFFICE = both)
# HUNTER_SHIPPING_CZK=150               # added to an out-of-range ad that ships before it is scored again
# HUNTER_TRAVEL_CZK_PER_KM=0            # shown next to the distance (there and back); 0 = not shown

# --- hard disks (defaults shown) ---
# HUNTER_HDD_MIN_TB=8                   # server fit: smaller disks are recorded (would_alert), never pushed

# --- watchlists (Phase 10 part 1; defaults shown) ---
# HUNTER_WATCH_TOPIC=watch              # ntfy topic read for watch add/list/stop/help commands
# NTFY_WATCH_TOKEN=tk_...               # read-only token for that topic (e.g. user deal-hunter-watch)
# HUNTER_WATCH_SCAN_HOURS=48            # how far back `hunt work` looks for listings to match
# HUNTER_WATCH_MAX_PER_DAY=10           # watch-hit pushes a day, separate from HUNTER_ALERT_MAX_PER_DAY
