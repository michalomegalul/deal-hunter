# Copy to .env and fill in. NEVER commit .env.
# Local dev database (dev-only credentials), e.g. from docker-compose.yml.
DATABASE_URL=postgresql://hunter:hunter@localhost:5432/hunter
# Optional tuning (defaults shown). HUNTER_MIN_DELAY can't go below 3 seconds.
# HUNTER_MIN_DELAY=3.5
# HUNTER_PAGES=2
# HUNTER_LOOP_MINUTES=10
# HUNTER_RECHECK_HOURS=6
# HUNTER_RECHECK_LIMIT=1500
